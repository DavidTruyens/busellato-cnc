FUN      104,ForoF4                    ;Funz. per la foratura in faccia 4

         OUT       &BYTE+FITTIZ1       ;
         OUT       &BYTE+FITTIZ2       ;
         OUT       &BYTE+FITTIZ3       ;
         SNZ       CAMBUT,SEG          ;Con cambio ut. no esclus.
         FCALL     71                  ;Funz. di test su esclusioni
         SNZ       FLGESCLU,ESCI       ;
SEG:     CALL      SCPUT10             ;Scrive byte su ut. dopo 10 lav.
         VEL       X                   ;
         VEL       Y                   ;
         VEL       Z                   ;
         CALL      VMANDR              ;
         CALL      QXARIA              ;
         CALL      QYLAVORO            ;
         SNZ       STUTPREC,NOARIA     ;Se=1 Batt. prec. con stessi Ut.
         CALL      SETTOOL             ;Utensili diversi
         FCALL     83                  ;Funz. set motori mandrini
         FCALL     81                  ;Funz. set utensili orizzontali
         SNZ       PNEUMAT             ;
         CALL      QZARIA              ;
NOARIA:  WEND      XYZ,Q               ;
         SNZ       PNEUMAT             ;
         CALL      QZLAVORO            ;
         WEND      Z,Q                 ;
         CALL      VXRALLE             ;
         CALL      QXRALLE             ;
         WEND      X,Q                 ;
         CALL      VXLAVORO            ;
         CALL      QXRALLU             ;
         WEND      X,Q                 ;
         CALL      VXRALLU             ;
         CALL      QXLAVORO            ;
         WEND      X,Q                 ;
         VEL       X                   ;
