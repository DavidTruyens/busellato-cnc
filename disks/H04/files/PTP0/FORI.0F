; *********** FUNZIONI DI FORATURA (SUPERJUNIOR - BUSELLATO) **************

FUN      101,ForoF1                    ;Funz. per la foratura in faccia 1
         SKZ       0+ATTUALE           ;
         RES       EVFSR               ;
         SKZ       1+ATTUALE           ;
         RES       EVFST               ;
         SKZ       2+ATTUALE           ;
         RES       EVFSA               ;
         SKZ       3+ATTUALE           ;
         RES       EVFSS               ;
         OUT       &BYTE+FITTIZ1       ;
         OUT       &BYTE+FITTIZ2       ;
         OUT       &BYTE+FITTIZ3       ;
         SNZ       CAMBUT,SEG          ;Con cambio ut. no esclus.
         FCALL     71                  ;Funz. di test su esclusioni
         SNZ       FLGESCLU,ESCI       ;
SEG:     CALL      SCPUT10             ;Scrive byte su ut. dopo 10 lav.
         VEL       X                   ;
         VEL       Y                   ;
         VEL       Z                   ;
         CALL      VMANDR              ;
         CALL      QXLAVORO            ;
         CALL      QYARIA              ;
         SNZ       STUTPREC,NOARIA     ;Se=1 Batt. prec. con stessi Ut.
         CALL      SETTOOL             ;Utensili diversi
         FCALL     83                  ;Funz. set motori mandrini
         FCALL     81                  ;Funz. set utensili orizzontali
         SNZ       PNEUMAT             ;
         CALL      QZARIA              ;
NOARIA:  WEND      XYZ,Q               ;
         SNZ       PNEUMAT             ;
         CALL      QZLAVORO            ;
         WEND      Z,Q                 ;
         CALL      VYRALLE             ;
         CALL      QYRALLE             ;
         WEND      Y,Q                 ;
         CALL      VYLAVORO            ;
         CALL      QYRALLU             ;
         WEND      Y,Q                 ;
         CALL      VYRALLU             ;
         CALL      QYLAVORO            ;
         WEND      Y,Q                 ;
         VEL       Y                   ;
         CALL      QYARIA              ;
         WEND      Y,Q                 ;
         SNZ       PNEUMAT             ;
         VEL       Z                   ;
ESCI:    SNZ       STESSUT             ;Se=1 Prossima batt. stesso Ut.
         FCALL     169                 ;Funzione di reset utensili
         CALL      QZARISCA            ;
         WEND      Z,Q                 ;
         FRET

;*****************  SUBROUTINE (F101) PER LA FACCIA 1 ********************

VMANDR:  VOUT      6,&VMAND
         RET

QXLAVORO:MOV       X,&QX
         RET

QYARIA:  MOV       Y,&QY
         RET

SETTOOL: OUT       &BYTE+PORTINS0
         OUT       &BYTE+PORTINS1
         OUT       &BYTE+PORTINS2
         OUT       &BYTE+PORTINS3
         OUT       &BYTE+PORTINS4
         OUT       &BYTE+PORTINS5
         OUT       &BYTE+PORTINS6
         OUT       &BYTE+PORTINS7
         OUT       &BYTE+PORTINS8
         OUT       &BYTE+PORTINS9
         RET

QZARIA:  MOV       Z,&QZ
         RET

QZLAVORO:MOV       Z,&QZ
         RET

VYRALLE: VEL       Y,&VELY
         RET

QYRALLE: MOV       Y,&QY
         RET

VYLAVORO:VEL       Y,&VELY
         RET

QYRALLU: MOV       Y,&QY
         RET

VYRALLU: VEL       Y,&VELY
         RET

QYLAVORO:MOV       Y,&QY
         RET

QZARISCA:MOV       Z,&QZ
         RET

SCPUT10: OUT       &BYTE+PUT10
         RET

; ***** NOTE: FUNZIONE (F101) FUNZIONE DI FORATURA IN FACCIA 1 *******

;ELENCO PARAMETRI:

;01  --> BYTE FITTIZIO1
;02  -->   "     "    2
;03  -->   "     "    3 ESCLUSIONI
;04  --> VOUT MANDRINO
;05  --> QX LAVORO
;06  --> QY ARIA
;07  --> MASK UT0
;08  --> MASK UT1
;09  --> MASK UT2
;10  --> MASK UT3
;11  --> MASK UT4
;12  --> MASK UT5
;13  --> MASK UT6
;14  --> MASK UT7
;15  --> MASK UT8
;16  --> MASK UT9
;17  --> QZ ARIA
;18  --> QZ LAVORO
;19  --> VELY R.E
;20  --> QY R.E
;21  --> VELY LAVORO
;22  --> QY R.U
;23  --> VELY R.U
;24  --> QY LAVORO
;25  --> QZ ARIA SCAMBIO
;26  --> BYTE UTENSILE DOPO 10 LAV.


FUN      102,ForoF2                    ;Funz. per la foratura in faccia 2

         OUT       &BYTE+FITTIZ1       ;
         OUT       &BYTE+FITTIZ2       ;
         OUT       &BYTE+FITTIZ3       ;
         SNZ       CAMBUT,SEG          ;Con cambio ut. no esclus.
         FCALL     71                  ;Funz. di test su esclusioni
         SNZ       FLGESCLU,ESCI       ;
SEG:     CALL      SCPUT10             ;Scrive byte su ut. dopo 10 lav.
         VEL       X                   ;
         VEL       Y                   ;
         VEL       Z                   ;
         CALL      VMANDR              ;
         CALL      QXLAVORO            ;
         CALL      QYARIA              ;
         SNZ       STUTPREC,NOARIA     ;Se=1 Batt. prec. con stessi Ut.
         CALL      SETTOOL             ;Utensili diversi
         FCALL     83                  ;Funz. set motori mandrini
         FCALL     81                  ;Funz. set utensili orizzontali
         SNZ       PNEUMAT             ;
         CALL      QZARIA              ;
NOARIA:  WEND      XYZ,Q               ;
         SNZ       PNEUMAT             ;
         CALL      QZLAVORO            ;
         WEND      Z,Q                 ;
         CALL      VYRALLE             ;
         CALL      QYRALLE             ;
         WEND      Y,Q                 ;
         CALL      VYLAVORO            ;
         CALL      QYRALLU             ;
         WEND      Y,Q                 ;
         CALL      VYRALLU             ;
         CALL      QYLAVORO            ;
         WEND      Y,Q                 ;
         VEL       Y                   ;
         CALL      QYARIA              ;
         WEND      Y,Q                 ;
         SNZ       PNEUMAT             ;
         VEL       Z                   ;
ESCI:    SNZ       STESSUT             ;Se=1 Prossima batt. stesso Ut.
         FCALL     169                 ;Funzione di reset utensili
         CALL      QZARISCA            ;
         WEND      Z,Q                 ;
         FRET

;*****************  SUBROUTINE (F102) PER LA FACCIA 2 ********************

VMANDR:  VOUT      6,&VMAND
         RET

QXLAVORO:MOV       X,&QX
         RET

QYARIA:  MOV       Y,&QY
         RET

SETTOOL: OUT       &BYTE+PORTINS0
         OUT       &BYTE+PORTINS1
         OUT       &BYTE+PORTINS2
         OUT       &BYTE+PORTINS3
         OUT       &BYTE+PORTINS4
         OUT       &BYTE+PORTINS5
         OUT       &BYTE+PORTINS6
         OUT       &BYTE+PORTINS7
         OUT       &BYTE+PORTINS8
         OUT       &BYTE+PORTINS9
         RET

QZARIA:  MOV       Z,&QZ
         RET

QZLAVORO:MOV       Z,&QZ
         RET

VYRALLE: VEL       Y,&VELY
         RET

QYRALLE: MOV       Y,&QY
         RET

VYLAVORO:VEL       Y,&VELY
         RET

QYRALLU: MOV       Y,&QY
         RET

VYRALLU: VEL       X,&VELY
         RET

QYLAVORO:MOV       Y,&QY
         RET

QZARISCA:MOV       Z,&QZ
         RET


SCPUT10: OUT       &BYTE+PUT10
         RET

; ***** NOTE: FUNZIONE (F102) FUNZIONE DI FORATURA IN FACCIA 2 *******

;ELENCO PARAMETRI:

;01  --> BYTE FITTIZIO1
;02  -->   "     "    2
;03  -->   "     "    3 ESCLUSIONI
;04  --> VOUT MANDRINO
;05  --> QX LAVORO
;06  --> QY ARIA
;07  --> MASK UT0
;08  --> MASK UT1
;09  --> MASK UT2
;10  --> MASK UT3
;11  --> MASK UT4
;12  --> MASK UT5
;13  --> MASK UT6
;14  --> MASK UT7
;15  --> MASK UT8
;16  --> MASK UT9
;17  --> QZ ARIA
;18  --> QZ LAVORO
;19  --> VELY R.E
;20  --> QY R.E
;21  --> VELY LAVORO
;22  --> QY R.U
;23  --> VELY R.U
;24  --> QY LAVORO
;25  --> QZ ARIA SCAMBIO
;26  --> BYTE UTENSILE DOPO 10 LAV.


FUN      103,ForoF3                    ;Funz. per la foratura in faccia 3

         OUT       &BYTE+FITTIZ1       ;
         OUT       &BYTE+FITTIZ2       ;
         OUT       &BYTE+FITTIZ3       ;
         SNZ       CAMBUT,SEG          ;Con cambio ut. no esclus.
         FCALL     71                  ;Funz. di test su esclusioni
         SNZ       FLGESCLU,ESCI       ;
SEG:     CALL      SCPUT10             ;Scrive byte su ut. dopo 10 lav.
         VEL       X                   ;
         VEL       Y                   ;
         VEL       Z                   ;
         CALL      VMANDR              ;
         CALL      QXARIA              ;
         CALL      QYLAVORO            ;
         SNZ       STUTPREC,NOARIA     ;Se=1 Batt. prec. con stessi Ut.
         CALL      SETTOOL             ;Utensili diversi
         FCALL     83                  ;Funz. set motori mandrini
         FCALL     81                  ;Funz. set utensili orizzontali
         SNZ       PNEUMAT             ;
         CALL      QZARIA              ;
NOARIA:  WEND      XYZ,Q               ;
         SNZ       PNEUMAT             ;
         CALL      QZLAVORO            ;
         WEND      Z,Q                 ;
NOASSEZ: CALL      VXRALLE             ;
         CALL      QXRALLE             ;
         WEND      X,Q                 ;
         CALL      VXLAVORO            ;
         CALL      QXRALLU             ;
         WEND      X,Q                 ;
         CALL      VXRALLU             ;
         CALL      QXLAVORO            ;
         WEND      X,Q                 ;
         VEL       X                   ;
         CALL      QXARIA              ;
         WEND      X,Q                 ;
         SNZ       PNEUMAT             ;
         VEL       Z                   ;
ESCI:    SNZ       STESSUT             ;Se=1 Prossima batt. stesso Ut.
         FCALL     169                 ;Funzione di reset utensili
         CALL      QZARISCA            ;
         WEND      Z,Q                 ;
         FRET


