QZLAVORO:MOV       Z,&QZ
         RET

VXRALLE: VEL       X,&VELX
         RET

QXRALLE: MOV       X,&QX
         RET

VXLAVORO:VEL       X,&VELX
         RET

QXRALLU: MOV       X,&QX
         RET

VXRALLU: VEL       X,&VELX
