;>>>>>>>> FUNZIONI DI FRESATA -  ELICOIDALE

FUN      136,FElicF1                   ;Fresata Elicoidale in faccia 1

         OUT       &BYTE+FITTIZ1       ;
         OUT       &BYTE+FITTIZ2       ;
         OUT       &BYTE+FITTIZ3       ;
         FCALL     71                  ;Funz. test su esclusioni
         SNZ       CAMBUT,SEG          ;Con cambio ut. no esclus.
         SNZ       FLGESCLU,ESCI       ;
SEG:     SKZ       FINCONT             ;Se=0 NO Contornatura
         ECNT                          ;
         SKZ       FCONTOR             ;Se=1 Contornatura
         ICNT      1                   ;
         CALL      XYFELIC             ;
ESCI:    FRET                          ;

;*****************  SUBROUTINE (F136) PER LA FACCIA 1 ********************

XYFELIC: HELIC     &ELICA
         RET


; **** NOTE: FUNZIONE (F136 FUNZIONE DI FRESATA ELICOIDALE IN FACCIA 1) ***

;ELENCO PARAMETRI:

;01  --> BYTE FITTIZIO1
