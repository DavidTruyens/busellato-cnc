;>>>>>>>>>>>>>>>>> FUNZIONI DI FRESATA - LINEARE

FUN      131,FLinAF1                   ;Fresata lineare in faccia 1

         OUT       &BYTE+FITTIZ1       ;
         OUT       &BYTE+FITTIZ2       ;
         OUT       &BYTE+FITTIZ3       ;
         SNZ       CAMBUT,SEG          ;Con cambio ut. no esclus.
         FCALL     71                  ;Funz. test su esclusioni
         SNZ       FLGESCLU,ESCI       ;
SEG:     SKZ       FINCONT             ;Se=0 NO Contornatura
         ECNT                          ;
         SKZ       FCONTOR             ;Se=1 Contornatura
         ICNT      1                   ;
         CALL      XYFLIN              ;
ESCI:    FRET                          ;

;*****************  SUBROUTINE (F131) PER LA FACCIA 1 ********************

XYFLIN:  LINEAR    &LINEA
         RET


; ***** NOTE: FUNZIONE (F131) FUNZIONE DI FRESATA LINEARE FACCIA 1 *******

;ELENCO PARAMETRI:

;01  --> BYTE FITTIZIO1
;02  -->   "     "    2
;03  -->   "     "    3 ESCLUSIONI
;Parametri passati alla  --> LINEAR XYFLIN
;04  --> MASCHERA ASSI
;05  --> DIREZIONE ASSE
;06  --> RATEIC
;07  --> PASSO RESOL
;08  --> QUOTA ASSE 1
;09  --> QUOTA ASSE 2
;10  --> QUOTA ASSE 3
;11  --> DIAGONALE


