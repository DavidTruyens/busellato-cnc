;21  --> QY ARIA 2
;22  --> QZ ARIA 2


;>>>>>>>>>>>>>>>>>>>> FUNZIONE DI  USCITA FRESA

FUN      126,UfresaF1                  ;Funz di Uscita fresa in faccia 1

         OUT       &BYTE+FITTIZ1       ;
         OUT       &BYTE+FITTIZ2       ;
         OUT       &BYTE+FITTIZ3       ;
         SNZ       CAMBUT,SEG          ;Con cambio ut. no esclus.
         FCALL     71                  ;Funz. test su esclusioni
         SNZ       FLGESCLU,ESCI       ;
SEG:     CALL      SCPUT10             ;
         CALL      QYARIA              ;
         WEND      Y,Q                 ;
;        GAIN      X,1.5               ;
;        GAIN      Y,1.5               ;
         VEL       Z                   ;
ESCI:    SNZ       STESSUT,USC         ;
         FCALL     169                 ;Funz. di reset utensili
         FCALL     77                  ;
USC:     SNZ       PNEUMAT             ;
         CALL      QZARISCA            ;
         WEND      Z,Q                 ;
         FRET                          ;



;*****************  SUBROUTINE (F126) PER LA FACCIA 1 ********************

QYARIA:  MOV       Y,&QY
         RET

QZARISCA:MOV       Z,&QZ
         RET

SCPUT10: OUT       &BYTE+PUT10
         RET

; ***** NOTE: FUNZIONE (F26) FUNZIONE DI USCITA FRESA IN FACCIA 1 *******

