;>>>>>>>>>>>>> FUNZIONI DI ENTRATA - USCITA FRESA

FUN      121,EfresaF1                  ;Funz. di entrata fresa in faccia 1

         SKZ       0+ATTUALE           ;
         RES       EVFSR               ;
         SKZ       1+ATTUALE           ;
         RES       EVFST               ;
         SKZ       2+ATTUALE           ;
         RES       EVFSA               ;
         SKZ       3+ATTUALE           ;
         RES       EVFSS               ;
         OUT       &BYTE+FITTIZ1       ;
         OUT       &BYTE+FITTIZ2       ;
         OUT       &BYTE+FITTIZ3       ;
         SNZ       CAMBUT,SEG          ;Con cambio ut. no esclus.
         FCALL     71                  ;Funz. test su esclusioni
         SNZ       FLGESCLU,ESCI       ;
SEG:     VEL       X                   ;
         VEL       Y                   ;
         VEL       Z                   ;
         CALL      VMANDR              ;
         CALL      QXARIA              ;
         CALL      QYARIA              ;
         SNZ       STUTPREC,SALTAUT    ;Se=1 Batt. prec. con stessi Ut.
         FCALL     79                  ;Reset porti utensile fittizi
         CALL      SETTOOL             ;Utensili diversi
         FCALL     82                  ;Funzione set utensili frese
         FCALL     78                  ;Funzione di rotazione frese
         FCALL     75                  ;Funzione di attivazione mot. frese
SALTAUT: SNZ       PNEUMAT,NOASSEZ     ;
         SNZ       STUTPREC            ;
         CALL      QZARIA              ;
NOASSEZ: WEND      XYZ,Q               ;
         SNZ       PNEUMAT             ;
         CALL      QZLAVORO            ;
         WEND      Z,Q                 ;
         CALL      VYLAVORO            ;
         CALL      QYLAVORO            ;
         WEND      Y,Q                 ;
ESCI:    FRET                          ;

;*****************  SUBROUTINE (F121) PER LA FACCIA 1 ********************

VMANDR:  VOUT      6,&VMAND
         RET

QXARIA:  MOV       X,&QX
         RET

QYARIA:  MOV       Y,&QY
         RET

SETTOOL: OUT       &BYTE+PORTINS0
         OUT       &BYTE+PORTINS1
         OUT       &BYTE+PORTINS2
         OUT       &BYTE+PORTINS3
         OUT       &BYTE+PORTINS4
         OUT       &BYTE+PORTINS5
         OUT       &BYTE+PORTINS6
         OUT       &BYTE+PORTINS7
         OUT       &BYTE+PORTINS8
         OUT       &BYTE+PORTINS9
         RET

QZARIA:  MOV       Z,&QZ
         RET

QZLAVORO:MOV       Z,&QZ
         RET

VYLAVORO:VEL       Y,&VELY
         RET

QYLAVORO:MOV       Y,&QY
         RET


; ***** NOTE: FUNZIONE (F121) FUNZIONE DI ENTRATA FRESA IN FACCIA 1 *******

;ELENCO PARAMETRI:

;01  --> BYTE FITTIZIO1
;02  -->   "     "    2
;03  -->   "     "    3 ESCLUSIONI
;04  --> VOUT MANDRINO
;05  --> QX ARIA
;06  --> QY ARIA
;07  --> MASK UT0
;08  --> MASK UT1
;09  --> MASK UT2
;10  --> MASK UT3
;11  --> MASK UT4
;12  --> MASK UT5
;13  --> MASK UT6
;14  --> MASK UT7
;15  --> MASK UT8
;16  --> MASK UT9
;17  --> QZ ARIA
;18  --> QZ LAVORO
;19  --> VY LAVORO
;20  --> QY LAVORO



FUN      122,EfresaF2                  ;Funz. di entrata fresa in faccia 2

         OUT       &BYTE+FITTIZ1       ;
         OUT       &BYTE+FITTIZ2       ;
         OUT       &BYTE+FITTIZ3       ;
         SNZ       CAMBUT,SEG          ;Con cambio ut. no esclus.
         FCALL     71                  ;Funz. test su esclusioni
         SNZ       FLGESCLU,ESCI       ;
SEG:     VEL       X                   ;
         VEL       Y                   ;
         VEL       Z                   ;
         CALL      VMANDR              ;
         CALL      QXARIA              ;
         CALL      QYARIA              ;
         WEND      XY,Q                ;
         SNZ       STUTPREC,SALTAUT1   ;Se=1 Batt. prec. con stessi Ut.
         FCALL     79                  ;Reset porti utensile fittizi
         CALL      SETTOOL             ;Utensili diversi
         FCALL     82                  ;Funzione set utensili frese
         FCALL     78                  ;Funzione di rotazione frese
         FCALL     75                  ;Funzione di attivazione mot. frese
SALTAUT1:SNZ       PNEUMAT,NOASSEZ     ;
         SNZ       STUTPREC            ;
;         CALL      QZARIA             ;
NOASSEZ: WEND      XYZ,Q               ;
         SNZ       PNEUMAT             ;
         CALL      QZLAVORO            ;
         WEND      Z,Q                 ;
         CALL      VYLAVORO            ;
         CALL      QYLAVORO            ;
         WEND      Y,Q                 ;
ESCI:    FRET                          ;

