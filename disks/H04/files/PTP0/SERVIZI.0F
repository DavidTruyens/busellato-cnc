;******************* FUNZIONE SERVIZIO PER SET POINT 4 ASSI

FUN      57,MovassZ                    ;Funzione setpoint asse Z su micro
                                       ;di SetPoint
         NORMAL    Z
         SETQ      Z,0
         SNZ       FCSPZ,DOPO
         VEL       Z,4
         MOV       Z,-1000
         WIZ       FCSPZ
         STOP      Z
         DELAY     0.05
         SETQ      Z,0
DOPO:    VEL       Z,0.2
         MOV       Z,100
         WNZ       FCSPZ
         SETQ      Z,0
         DELAY     0.1
         MESSAGE   37,2                ;Setpoint asse Z OK
         FRET

FUN      58,MovassY                    ;Funzione setpoint asse Y su micro
                                       ;di SetPoint
         NORMAL    Y
         SETQ      Y,0
         SNZ       FCSPY,DOPOY
         VEL       Y,10
         MOV       Y,-2000
         WIZ       FCSPY
         STOP      Y
         DELAY     0.3
         SETQ      Y,0
DOPOY:   VEL       Y,0.2
         MOV       Y,50
         WNZ       FCSPY
         SETQ      Y,0
         DELAY     0.1
         MESSAGE   38,2                ;Setpoint asse Y OK
         FRET

FUN      59,MovassX                    ;Funzione setpoint asse X su micro
                                       ;di SetPoint
         NORMAL    X
         SETQ      X,0
         SNZ       FCSPX,DOPOX
         VEL       X,10
         MOV       X,-5000
         WIZ       FCSPX
         STOP      X
         DELAY     0.3
         SETQ      X,0
DOPOX:   VEL       X,0.2
         MOV       X,50
         WNZ       FCSPX
         SETQ      X,0
         DELAY     0.1
         MESSAGE   39,2                ;Setpoint asse X OK
         FRET


