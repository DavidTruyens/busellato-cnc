64"   AUTOMATICO"
64"@ESC@            Cancela los caracteres de una casilla"
64"@TAB@            Deplaza la barra a derecha de una casilla"
64"@SHIFT+TAB@      Deplaza la barra a izquierda de una casilla"
64"@RETURN@         Pasa al proximo campo a editar"
64"@CTRL+Y@         Cancelacion de la linea "
64"@CTRL+U@         Restablece ultima linea cancelada "
64"@CTRL+RETURN@    Insercion de una linea "
64"@CTRL+HOME@      Emplazamiento rapido al inicio de la lista"
64"@CTRL+END@       Emplazamiento rapido a la fin de la lista"
64"@CTRL+D@         Vacia la lista corriente"
64"@CTRL+N@         Para insercion numero de repeticion"
64"@CTRL+S@         Busqueda de una palabla en la lista"
64"@PGUP@           Pasa a la pagina precedente"
64"@PGDW@           Pasa a la pagina siguiente "
64"@\x18@              Pasa a la linea precedente"
64"@\x19@              Pasa a la linea siguiente "
64"@F2@             Pone en ejecucion la lista"
64"@F3@             Pone la lista en estado de STOP"
64"@F6@             Acaba ejecucion de la lista y sale      "
64"@F7@             Llama lista de directorio"
64"@F8@             Memoriz. lista automatico en directorio listas"
64"@F10@            Acquisicion directa programas de directorio"
64""
64"   SET POINT & DIAGNOSTICA"
64"@F2@             Pone en ejecucion el proceso  "
64"@F3@             Pone el programa en estado de STOP "
64"@F6@             Acaba ejecucion del proceso        "
64""
64"   MENU & HELP"
64"@ESC@            Salida de  MENU y de  HELP"
64"@PGUP@           Pasa a la pagina  precedente"
64"@PGDW@           Pasaaa la pagina siguiente  "
64"@\x18@              Pasa a la linea precedente"
64"@\x19@              Pasa a la linea siguiente "
64"@ENTER@          Selecciona item evidenciado  "
64""
